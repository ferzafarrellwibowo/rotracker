# Roblox Open Cloud API Key (Dashboard -> Credentials -> Create API Key with Inventory Read)
ROBLOX_OPEN_CLOUD_API_KEY=

# Roblox Cookie (.ROBLOSECURITY) - Optional fallback
ROBLOX_COOKIE=

# Discord Interactions Bot Configuration (https://discord.com/developers/applications)
# Dapatkan dari General Information:
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Dapatkan dari Bot tab -> Reset Token:
DISCORD_BOT_TOKEN=

# URL domain website Anda (misal https://rotracker.vercel.app atau domain custom)
# untuk tombol "Open in roTracker Web"
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Opsional: Jika ingin registrasi command instan ke 1 server Discord untuk testing
DISCORD_GUILD_ID=
